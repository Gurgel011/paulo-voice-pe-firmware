# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_APP_WIFI_SSID="Antena  1  94.7  FM"
CONFIG_APP_WIFI_PASSWORD="nat13server13"
CONFIG_APP_SERVER_BASE_URL="http://192.168.2.160:8091"
CONFIG_APP_DEVICE_ID="voice-pe-paulo"
CONFIG_APP_DEVICE_NAME="Assistente de Voz do Paulo"
